# Arkhimedes — API Credentials Şablonu
# Bu dosyayı .env olarak kopyala ve gerçek değerlerle doldur:
#   cp .env.example .env
# .env gitignore'da, repo'ya dahil EDİLMEZ.

# ─── MKK VYK API (KAP duyuruları için) ──────────────────────────────────────
# Kayıt: https://apigwdev.mkk.com.tr/
MKK_API_KEY=your-mkk-api-key-here
MKK_API_SECRET=your-mkk-api-secret-here

# ─── EVDS API (TCMB makro verileri için) ────────────────────────────────────
# Kayıt: https://evds2.tcmb.gov.tr/index.php?/evds/userDocs
EVDS_API_KEY=your-evds-api-key-here

# ─── Notlar ──────────────────────────────────────────────────────────────────
# İş Yatırım: public scraping, API key gerektirmez
# Yahoo Finance: yfinance kütüphanesi, API key gerektirmez
